{
  "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
  "tasks": [
    {
      "name": "run-prettier",
      "command": "yarn",
      "args": ["format"],
      "pathMode": "absolute"
    },
    {
      "name": "run-csharpier",
      "command": "dotnet",
      "args": [ "csharpier", "${staged}" ],
      "include": [ "**/*.cs" ]
    }
  ]
}
